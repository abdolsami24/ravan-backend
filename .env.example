# RAVAN backend — copy to .env and fill in YOUR values. Never commit a real .env.
# On Hostinger shared MySQL the host is usually localhost; use the DB host
# shown in hPanel > Databases if it differs.
PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASS=your_mysql_password
DB_NAME=ravan
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
# OTP: dev mode returns the OTP in the API response (no SMS provider yet).
# Set OTP_DEV_MODE=false in production and wire an SMS provider instead.
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
